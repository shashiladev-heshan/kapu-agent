# ── Claude credentials ──────────────────────────────────────────────
# Provide ONE of the two — the engine auto-selects:
#   ANTHROPIC_API_KEY    — standard API key (sk-ant-api...) → fast Messages
#                          API engine. Recommended for the hosted demo.
#   ANTHROPIC_AUTH_TOKEN — Claude subscription OAuth token (sk-ant-oat...,
#                          from `claude setup-token`) → Claude Agent SDK
#                          engine. Great for local dev on a Claude plan.
# Force an engine with KAPU_ENGINE=api | agent-sdk (optional).
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# KAPU_ENGINE=

# Model for the agent loop (claude-sonnet-4-6 = fast/cheap, claude-opus-4-8 = max quality)
KAPU_MODEL=claude-sonnet-4-6

# ── Kapruka MCP ─────────────────────────────────────────────────────
KAPRUKA_MCP_URL=https://mcp.kapruka.com/mcp

# ── Voice (one key is enough; OPENAI_API_KEY alone covers everything) ─
# Voice INPUT: browser Web Speech API (free, Chrome supports si-LK), with
#   OpenAI Whisper (/api/stt) as the fallback for other browsers.
# Voice OUTPUT (tried in order per language, browser-voice as last resort):
#   OPENAI_API_KEY      — gpt-4o-mini-tts: natural Sinhala/Tamil/English with
#                         Sri Lankan delivery instructions  ← RECOMMENDED
#   OPENAI_TTS_VOICE    — coral|nova|shimmer|alloy|ash|ballad|echo|fable|onyx|sage|verse (default: coral — warm female, fits Kapu)
#   OPENAI_TTS_MODEL    — default: gpt-4o-mini-tts (latest steerable TTS model)
#   ELEVENLABS_API_KEY  — premium English/Tamil voices (no Sinhala)
#   AZURE_SPEECH_KEY    — dedicated si-LK/ta-LK neural voices (free F0 tier)
OPENAI_API_KEY=
OPENAI_TTS_VOICE=
OPENAI_TTS_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── MongoDB (optional — app runs with in-memory sessions without it) ─
MONGODB_URI="mongodb://localhost:27017/kapu-agent"

# ── Auth (optional — app is guest-only without these) ──────────────────
# Google OAuth Web client ID (Google Cloud Console → Credentials → OAuth
# client ID → Web application; add http://localhost:3100 and your Railway
# domain as Authorized JavaScript origins — no redirect URI needed, no
# client secret needed: the GIS ID-token flow is verified server-side).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Stable secret for signing auth cookies (any long random string). Without
# it a per-boot secret is used and sign-ins reset on redeploy.
KAPU_AUTH_SECRET=

# ── Telegram channel (optional — /api/telegram is dormant without it) ──
# @BotFather → /newbot → paste the token. Local test: node scripts/tg-poll.mjs
# After deploy: curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<YOUR_DOMAIN>/api/telegram&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# exchangerate-api.com (free tier) — display-currency conversion for the LKR/USD/GBP... toggle
EXCHANGE_API_KEY=

# ChromaDB — Kapruka knowledge base (policies/FAQs RAG). Optional; falls back to in-process+Mongo vectors.
# Railway: private-net service URL e.g. http://chroma.railway.internal:8000 · Local: http://localhost:8000
CHROMA_URL=
